{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deadlock Mod Studio",
  "version": "0.1.0",
  "identifier": "app.deadlockmodstudio.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deadlock Mod Studio",
        "width": 1200,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExRUQ5ODdENzIwM0UyMDQKUldRRTRnTnlmWmp0RVpkbUYvNVltem1tVXlQRkJBVUo2dFMvbndKanI5VGlIRHJUR2V5dGEycUYK",
      "endpoints": [
        "https://github.com/MilkForBone2020/deadlock-mod-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
